# ─── Omnibus Environment Configuration ───────────────────────────────────────
# Copy this file to .env and fill in your values before starting Omnibus.
# Never commit your actual .env file — it is listed in .gitignore.

# ─── Core ─────────────────────────────────────────────────────────────────────
PORT=9810
DB_PATH=/appdata/omnibus.db
COMICS_PATH=/comics          # Path inside the container; map your host path in docker-compose.yml
LOG_LEVEL=info               # error | warn | info | debug

# ─── ComicVine ────────────────────────────────────────────────────────────────
# Get yours at https://comicvine.gamespot.com/api/
CV_API_KEY=your_comicvine_api_key_here

# ─── Anthropic ────────────────────────────────────────────────────────────────
# Used for AI-assisted event generation and annual validation
# Get yours at https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ─── Prowlarr ─────────────────────────────────────────────────────────────────
PROWLARR_URL=http://prowlarr:9696
PROWLARR_API_KEY=your_prowlarr_api_key_here

# ─── SABnzbd ──────────────────────────────────────────────────────────────────
SABNZBD_URL=http://sabnzbd:8080
SABNZBD_API_KEY=your_sabnzbd_api_key_here

# ─── Auth / JWT ───────────────────────────────────────────────────────────────
# Generate a strong random secret before going live:
#   Linux/Mac:  openssl rand -hex 32
#   Windows:    python -c "import secrets; print(secrets.token_hex(32))"
# Changing this value will invalidate all active sessions (everyone gets logged out).
JWT_SECRET=change-me-to-a-long-random-string-before-going-live

# ─── Reverse Proxy ────────────────────────────────────────────────────────────
# Set this to your public-facing URL if running behind a reverse proxy (Caddy, Nginx, etc.)
# Required for OIDC SSO redirect URI to work correctly.
# Leave blank if accessing Omnibus directly (e.g. http://localhost:9810)
OMNIBUS_URL=https://omnibus.yourdomain.com

# ─── OIDC / SSO (optional — any OIDC-compatible provider) ───────────────────
# Leave all three blank to disable SSO; local username/password login still works.
#
# OIDC_BASE_URL is the base path to your provider's OIDC endpoints:
#   Authentik:  https://auth.yourdomain.com/application/o
#   Keycloak:   https://auth.yourdomain.com/realms/myrealm/protocol/openid-connect
#   Google:     https://accounts.google.com
OIDC_BASE_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# ─── Volume host paths (used by docker-compose.yml) ──────────────────────────
# These are paths on your HOST machine that get mounted into the container.
COMICS_HOST_PATH=/path/to/your/comics        # e.g. D:/Comics on Windows, /mnt/comics on Linux

# Downloads — single folder is simplest. Split into two if you want NZB and torrent
# downloads in separate locations.
DOWNLOADS_HOST_PATH=/path/to/downloads       # Maps to /downloads inside the container
TORRENTS_HOST_PATH=/path/to/torrents         # Maps to /downloads/torrents inside the container
                                             # Can be the same as DOWNLOADS_HOST_PATH if you prefer one folder

# ─── Backups and secrets ──────────────────────────────────────────
# Encrypts the API keys stored in the database. deploy.ps1 adds one when missing.
# Keep a copy: a backup restored onto another machine needs the same value.
OMNIBUS_SECRET=
# Second backup folder on another drive or a NAS (mounted at /backup-copy;
# turn it on in Settings › Backups). Example: E:\OmnibusBackups
BACKUP_COPY_HOST_PATH=
